{
  "name": "tnc-inventory-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply tnc-vattu --local",
    "build": "wrangler deploy --dry-run --outdir build"
  },
  "dependencies": { "jose": "6.2.12" },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.0-beta",
    "typescript": "7.0.2",
    "wrangler": "4.151.2"
  }
}
